       "name": "ATL-CR-001",
       "shortDescription": {
        "text": "Bulk environment dump"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
       "id": "ATL-TP-003",
       "name": "ATL-TP-003",
       "shortDescription": {
        "text": "Instruction-override phrase"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
       "id": "ATL-TP-005",
       "name": "ATL-TP-005",
       "shortDescription": {
        "text": "Coercive tool-ordering instruction (shadowing pattern)"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "5.5"
       }
      },
      {
       "id": "ATL-CE-001",
       "name": "ATL-CE-001",
       "shortDescription": {
        "text": "Shell command execution (shell=True / os.system / child_process.exec)"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "5.5"
       }
      },
      {
       "id": "ATL-CE-002",
       "name": "ATL-CE-002",
