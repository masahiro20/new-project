        "text": "Instruction to disable agent safety / permissions"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
