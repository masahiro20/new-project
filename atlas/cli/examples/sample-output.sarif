        "text": "Dynamic code evaluation (eval / new Function / vm)"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "5.5"
       }
      },
      {
