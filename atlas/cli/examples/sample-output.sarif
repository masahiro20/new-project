        "text": "Decode-then-execute"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
