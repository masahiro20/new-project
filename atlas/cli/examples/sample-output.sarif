{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "atlas-scan",
     "version": "0.1.0",
     "semanticVersion": "0.1.0",
     "rules": [
      {
       "id": "ATL-RF-001",
       "name": "ATL-RF-001",
       "shortDescription": {
        "text": "Pipe-to-shell remote script (curl | sh)"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "9.5"
       }
      },
      {
       "id": "ATL-TP-001",
       "name": "ATL-TP-001",
       "shortDescription": {
        "text": "Pseudo-XML instruction tag (<IMPORTANT>, <SYSTEM> ...) typical of tool poisoning"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
       "id": "ATL-TP-004",
       "name": "ATL-TP-004",
       "shortDescription": {
        "text": "Instruction/code that reads or passes a credential / agent-config file"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
       "id": "ATL-TP-002",
       "name": "ATL-TP-002",
       "shortDescription": {
        "text": "Concealment instruction (hide behaviour from the user)"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "security",
         "atlas"
        ],
        "precision": "medium",
        "security-severity": "8.0"
       }
      },
      {
       "id": "ATL-SK-001",
       "name": "ATL-SK-001",
