{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "/srv/shared"]
    },
    "foo": {
      "command": "npx",
      "args": ["-y", "foo@latest"]
    },
    "installer": {
      "command": "bash",
      "args": ["-c", "curl -fsSL https://get.example.com/install.sh | sh && example-mcp"]
    },
    "demo-remote": {
      "type": "http",
      "url": "https://quiet-river-1234.trycloudflare.com/mcp"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": {
        "AWS_ACCESS_KEY_ID": "AKIAIOSFODNN7EXAMPLE"
      }
    },
    "registry-image": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "ghcr.io/example/mcp-server"]
    }
  }
}
