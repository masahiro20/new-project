# Claude API キー（https://console.anthropic.com で発行）。未設定だとエージェント機能は使えません（即時ルールチェックと条文表示は動きます）
ANTHROPIC_API_KEY=

# 使用モデル（省略時 claude-opus-5-5）
LAW_AGENT_MODEL=claude-opus-5-5

# 国土交通省 不動産情報ライブラリの API キー（無料・申請制。https://www.reinfolib.mlit.go.jp/ の「API利用申請」から）。
# 未設定でも動きますが、住所からの用途地域・区域区分・防火指定・災害区域の自動取得ができません
REINFOLIB_API_KEY=

# 公開URL（メタデータに使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 社内用の共有アクセスキー。設定すると /api/consult に x-access-key ヘッダが必要になります（画面に入力欄が出ます）
ACCESS_PASSWORD=

# 1つのIPあたりのエージェント実行回数の上限（1時間）
CONSULT_RATE_LIMIT=20
