# Claude API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# Stripe のシークレットキー（https://dashboard.stripe.com/apikeys）
STRIPE_SECRET_KEY=

# 公開URL（Stripe の戻り先とサイトマップに使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 販売価格（円・税込）
PRICE_JPY=2980

# 共通レート制限（任意。未設定ならインスタンスごとのメモリ上の制限になる）
# https://console.upstash.com で Redis を作成し、REST の URL とトークンを記入
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile（任意。無料お試しのロボット対策。両方未設定なら確認を省略）
# https://dash.cloudflare.com の Turnstile でサイトを追加して発行
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ローカル開発で決済を省略する場合のみ true（本番では絶対に設定しない）
PAYMENT_DISABLED=false
