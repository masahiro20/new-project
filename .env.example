# 公開モード。free にすると決済（購入ボタン・Checkout API・特商法表記）を無効にし、
# 運営者情報は「減算ゼロ運営事務局／連絡先：準備中」で表示する。AI 生成は ANTHROPIC_API_KEY があるときだけ動く
LAUNCH_MODE=

# Claude API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# Stripe のシークレットキー（https://dashboard.stripe.com/apikeys）
STRIPE_SECRET_KEY=

# 公開URL（Stripe の戻り先とサイトマップに使用）。未設定なら Vercel の VERCEL_PROJECT_PRODUCTION_URL を使う
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 販売価格（円・税込）
PRICE_JPY=2980

# 共通レート制限（任意。未設定ならインスタンスごとのメモリ上の制限になる）
# https://console.upstash.com で Redis を作成し、REST の URL とトークンを記入
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile（任意。無料お試しのロボット対策。両方未設定なら確認を省略）
# https://dash.cloudflare.com の Turnstile でサイトを追加して発行
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 決済モード（docs/demo-payments.md）。未設定なら STRIPE_SECRET_KEY の有無で自動判定（なし→demo、あり→stripe）
# demo：お金は動かず、テストカード 4242 4242 4242 4242 で購入の流れを確認できる。全ページに「デモ」バナーを表示
PAYMENTS_MODE=

# demo の購入トークンを署名する秘密の文字列（AI 生成と demo を組み合わせるサーバー環境で必須。例：openssl rand -hex 32）
DEMO_SIGNING_SECRET=

# プライバシーポリシーに表示するホスティング事業者（任意。無料・デモでは既定で GitHub Pages）
HOSTING_PROVIDER=

# アクセス解析（任意）。GoatCounter のサイトコード（https://<code>.goatcounter.com の <code>）。未設定なら計測しない
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Google Search Console の所有確認（任意。HTML タグの content の値）。docs/search-console.md 参照
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 静的サイト（GitHub Pages）から使う購入・生成 API（worker/）の URL。設定して書き出すと購入ボタンが出る（docs/paid-launch.md）
NEXT_PUBLIC_PAID_API_URL=
# 静的サイト側に Worker の決済モードを伝える（demo / stripe）。worker/wrangler.jsonc の PAYMENTS_MODE とそろえる
NEXT_PUBLIC_PAYMENTS_MODE=

# テスト専用：1 にすると、ANTHROPIC_API_KEY がないとき AI の代わりに決まった出力を返す（本番では設定しない）
AI_MOCK=
