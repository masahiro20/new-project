 const fromB64url = (s: string) => Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/")), (c) => c.charCodeAt(0));
 
+const hmacKey = () => crypto.subtle.importKey("raw", enc.encode(signingSecret()), { name: "HMAC", hash: "SHA-256" }, false, ["sign", "verify"]);
