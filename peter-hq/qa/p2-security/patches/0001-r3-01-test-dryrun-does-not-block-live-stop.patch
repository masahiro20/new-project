@@ -184,6 +184,20 @@ export const claimHookEvent = (kv: KV, id: string, event: string) => kv.set(k.ho
 export const listAccounts = (kv: KV) => kv.smembers(k.accounts());
 export const getState = (kv: KV, acct: string, id: string) => getJSON<GuardState>(kv, k.state(acct, id));
 export const saveState = (kv: KV, acct: string, id: string, s: GuardState) => setJSON(kv, k.state(acct, id), s);
+
+/**
+ * Arming "live": drop a stoppedAt that a test-mode dry run wrote before stopTestedAt
+ * existed (data from before this fix). Only a live stop sets stoppedAt now, so when the
+ * connection comes from test/off any stoppedAt of this month is that leftover — kept, it
+ * would block the armed stop until the next month.
+ */
+export async function clearStoppedAt(kv: KV, acct: string, id: string): Promise<void> {
+  const s = await getState(kv, acct, id);
+  if (s?.stoppedAt) {
+    delete s.stoppedAt;
+    await saveState(kv, acct, id, s);
+  }
+}
