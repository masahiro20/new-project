+  // Same server-side sign-out check as accountFrom (lib/api.ts).
+  const e = await getEntitlement(getKV(), claims.sub);
+  if (e?.sessionsValidAfter && (claims.iat ?? 0) < e.sessionsValidAfter) return null;
+  return claims;
 }
 
 export async function GET(request: Request) {
