--- a/signal-lab/budget-guard/lib/entitlements.ts
+++ b/signal-lab/budget-guard/lib/entitlements.ts
@@ -18,6 +18,8 @@ export type Entitlement = {
   paymentIntentId?: string;
   createdAt: string;
   updatedAt: string;
+  /** Access cookies issued before this (epoch seconds) are rejected — set by sign-out. */
+  sessionsValidAfter?: number;
 };
 
 export type NewEntitlement = Omit<Entitlement, "licenseKey" | "createdAt" | "updatedAt" | "status"> & { status?: EntitlementStatus };
@@ -84,6 +86,12 @@ export async function upsertEntitlement(
   return { entitlement, created: true };
 }
 
+/** Server-side sign-out: every access cookie issued before now stops working. */
+export async function revokeSessions(kv: KV, id: string, nowSeconds = Math.floor(Date.now() / 1000)): Promise<void> {
+  const e = await getEntitlement(kv, id);
+  if (e) await setJSON(kv, k.ent(id), { ...e, sessionsValidAfter: nowSeconds, updatedAt: new Date().toISOString() });
+}
+
 export async function setStatus(kv: KV, e: Entitlement, status: EntitlementStatus): Promise<Entitlement> {
   const next = { ...e, status, updatedAt: new Date().toISOString() };
   await setJSON(kv, k.ent(e.id), next);
