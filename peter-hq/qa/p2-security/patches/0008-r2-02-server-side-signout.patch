diff --git a/signal-lab/budget-guard/lib/api.ts b/signal-lab/budget-guard/lib/api.ts
index 06cf97f..43d241f 100644
--- a/signal-lab/budget-guard/lib/api.ts
+++ b/signal-lab/budget-guard/lib/api.ts
@@ -65,6 +65,8 @@ export async function accountFrom(request: Request, kv: KV): Promise<Account | n
   const claims = await verifyAccessToken(readCookie(request, ACCESS_COOKIE));
   if (!claims) return null;
   const entitlement = await resolveEntitlement(kv, claims.sub);
+  // Signed out (server side) after this cookie was issued → the cookie is dead even if it was copied.
