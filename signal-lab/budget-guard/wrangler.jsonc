{
  // Cloudflare Workers (free plan) via OpenNext. See docs/deploy-cloudflare.md.
  // Secrets are NOT stored here: `wrangler secret put NAME` (prod) / .dev.vars (local).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-guard",
  // Custom entry: OpenNext's generated .open-next/worker.js + a scheduled() handler for the cron.
  "main": "cf-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Every minute: each run checks a small slice of this hour's connections (lib/guard/cron.ts),
  // so one run stays within the free plan's 10 ms CPU / 50 subrequests. One trigger of the
  // 5 per account (free plan). vercel.json keeps its single hourly call.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    // Connections per cron run (≈30 KV requests + provider calls < 50 subrequests, ~3 ms CPU).
    // 60 runs/hour × 2 = up to ~118 connections per hour. See docs/deploy-cloudflare.md §7.
    "CRON_BATCH_SIZE": "2"
  },
  "observability": {
    "enabled": true
  }
}
