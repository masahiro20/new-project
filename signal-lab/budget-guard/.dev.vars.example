# Local values for `npm run preview` (workerd). Copy to .dev.vars (git-ignored).
# DUMMY values only — never put real keys here. Production: `npx wrangler secret put NAME`.
# The ACCESS_SECRET / TOKEN_ENCRYPTION_KEY below are refused unless PAYMENTS_MODE=demo (R1-13);
# generate real ones (openssl rand -base64 32) before anyone else can reach the deployment.

# Demo payments: no money moves, every page shows 「デモ：実際の請求はありません」.
PAYMENTS_MODE=demo
# NB: static pages bake the banner at build time — build with the same value:
#   PAYMENTS_MODE=demo npm run preview

# 32+ chars. Dummy for local use only (production: openssl rand -base64 32).
ACCESS_SECRET=local-dummy-access-secret-change-me-0123456789
# 32 bytes, base64. Dummy (production: openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Cron route auth (Authorization: Bearer $CRON_SECRET). Dummy.
CRON_SECRET=local-dummy-cron-secret

# Leave Upstash unset locally → in-memory KV (per isolate, lost on restart).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional
# RESEND_API_KEY=
# MAIL_FROM="Budget Guard <alerts@example.com>"
# ADMIN_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
