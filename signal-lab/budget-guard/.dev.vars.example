# Template for local `npm run preview` (workerd). Don't copy it by hand: run
#   npm run cf:dev-vars
# which writes .dev.vars (git-ignored) with a fresh random value for every __GENERATE__ below.
# The Worker refuses placeholder, example, empty or short secrets (lib/secrets.ts), also with
# PAYMENTS_MODE=demo — a demo deployment still holds real cookies and real provider tokens.
# Production: `npx wrangler secret put NAME` with values from `openssl rand -base64 32`.

# Demo payments: no money moves, every page shows 「デモ：実際の請求はありません」.
PAYMENTS_MODE=demo
# NB: static pages bake the banner at build time — build with the same value:
#   PAYMENTS_MODE=demo npm run preview

# 32+ characters.
ACCESS_SECRET=__GENERATE__
# 32 random bytes, base64.
TOKEN_ENCRYPTION_KEY=__GENERATE_KEY__
# Cron route auth (Authorization: Bearer $CRON_SECRET). 32+ characters.
CRON_SECRET=__GENERATE__

# Leave Upstash unset locally → in-memory KV (per isolate, lost on restart).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional
# RESEND_API_KEY=
# MAIL_FROM="Budget Guard <alerts@example.com>"
# ADMIN_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
