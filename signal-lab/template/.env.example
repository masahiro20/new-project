# すべて未設定でも `npm run dev` / `npm run build` は動きます（README の「開発用フォールバック」参照）。
# 本番（Vercel）では ★ を必ず設定してください。

# ★ 公開URL（Stripe の戻り先・OGP・sitemap に使用。ビルド時に埋め込まれます）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ★ Stripe（https://dashboard.stripe.com/apikeys）。未設定の開発環境では「開発用チェックアウト」になります
STRIPE_SECRET_KEY=
# ★ Webhook の署名シークレット（ローカルは `stripe listen --forward-to localhost:3000/api/stripe/webhook` で表示）
STRIPE_WEBHOOK_SECRET=

# ★ アクセス Cookie の署名鍵（32文字以上）。生成例: openssl rand -base64 32
ACCESS_SECRET=

# ★ Upstash Redis（未設定の開発環境ではメモリ上のストアを使用。本番では必須）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend（未設定ならメールはコンソールに出力されるだけ）
RESEND_API_KEY=
MAIL_FROM="Signal Demo <hello@example.com>"

# 任意：/api/admin/stats を読むためのトークン
ADMIN_TOKEN=

# 任意：ローカル開発で Stripe キーがあっても決済を省略する場合のみ true（本番では無視されます）
PAYMENT_DISABLED=false

# 任意：複数インスタンス間で Server Action の暗号鍵を固定する場合（openssl rand -base64 32）
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
