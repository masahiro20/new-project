# Allowlist (security review A-07): exclude everything, then re-include only what the Dockerfile COPYs.
*
!package.json
!package-lock.json
!tsconfig.json
!scripts/build-cli.mjs
!scripts/third-party-notices.mjs
!src/
!deploy/docker-entrypoint.sh
!deploy/kotomark-cli.sh
# Never, wherever they are (even under src/).
**/.env
**/.env.*
**/*.pem
**/*signing-key*
