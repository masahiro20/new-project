{
  "name": "kotomark",
  "version": "0.1.0",
  "private": true,
  "description": "Whole-script consistency QA for JA<->EN game localization (remote MCP server + CLI). Working name, trademark check pending.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kotomark": "dist/kotomark.mjs"
  },
  "files": [
    "dist/kotomark.mjs",
    "README.md",
    "docs/ci.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "build:action": "npm run build:cli && node -e \"require('fs').mkdirSync('action/dist',{recursive:true});require('fs').copyFileSync('dist/kotomark.mjs','action/dist/kotomark.mjs')\"",
    "release:action": "node scripts/release-action.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check:sample": "tsx src/cli/index.ts check samples/ja-en/script.csv --glossary samples/ja-en/glossary.json",
    "serve": "tsx src/server/index.ts",
    "admin": "tsx src/server/admin.ts",
    "start": "node dist/server/index.js",
    "build:demo": "node web/build-demo.mjs",
    "kotomark": "tsx src/cli/index.ts",
    "build:site": "npm run build:demo && node web/build-site.mjs"
  },
  "license": "Elastic-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
