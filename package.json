{
  "name": "gensan-zero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export:pages": "./scripts/export-pages.sh",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "node --test --experimental-strip-types --no-warnings tests/payments.test.mjs tests/check.test.mjs tests/quality.test.mjs tests/security.test.mjs tests/guides.test.mjs",
    "og:generate": "node scripts/og/extract-guides.mjs . > scripts/og/guides.json && node scripts/og/generate-og.mjs --in scripts/og/guides.json --out public/og --png && rm -f public/og/*.svg",
    "api:dev": "wrangler dev -c worker/wrangler.jsonc",
    "api:deploy": "wrangler deploy -c worker/wrangler.jsonc",
    "api:check": "wrangler deploy -c worker/wrangler.jsonc --dry-run --outdir .wrangler/dry-run",
    "quality": "esbuild scripts/quality/run.ts --bundle --platform=node --format=esm --outfile=.quality/run.mjs --log-level=warning && node .quality/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@opennextjs/cloudflare": "1.20.6",
    "docx": "^9.8.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.3",
    "wrangler": "4.136.3"
  }
}
